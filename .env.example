# ─── Lumiere AI Service — .env.example ────────────────────────────────────────
# Copy file này thành .env và điền giá trị thực. KHÔNG commit .env vào git.

# ── Auth ───────────────────────────────────────────────────────────────────────
# Shared secret với Spring Boot backend. Phải khớp với AI_SERVICE_KEY trong .env của backend.
AI_SERVICE_KEY=change-me

# ── Server ─────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8001

# ── Backend internal APIs ──────────────────────────────────────────────────────
# URL của lumiere-restaurant-backend (Spring Boot)
BACKEND_BASE_URL=http://localhost:8080

# ── LLM — Google AI Studio (Gemini) ───────────────────────────────────────────
# Lấy API key tại: https://aistudio.google.com/app/apikey
#
# LLM_PROVIDER: để "google_generative" để service tự dùng Native Gemini API
#   (/v1beta/models/{model}:generateContent) thay vì OpenAI-compatible endpoint.
#
# LLM_BASE_URL: URL gốc của Google AI Studio. Service tự build endpoint đầy đủ.
#   Nếu muốn dùng Gemini qua OpenAI-compatible endpoint thì đổi thành:
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#
# LLM_MODEL: model ID từ Google AI Studio. Ví dụ:
#   gemini-1.5-flash     — nhanh, rẻ, đủ dùng cho chatbot nhà hàng
#   gemini-2.0-flash     — nhanh hơn, context dài hơn
#   gemini-1.5-pro       — mạnh hơn nhưng chậm và đắt hơn
LLM_PROVIDER=google_generative
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_API_KEY=your_google_ai_studio_api_key
LLM_MODEL=gemini-1.5-flash

# ── Vector DB — Qdrant ─────────────────────────────────────────────────────────
# Chạy local: docker run -p 6333:6333 qdrant/qdrant
# Hoặc dùng Qdrant Cloud: https://cloud.qdrant.io
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=menu_items

# ── Embedding model ────────────────────────────────────────────────────────────
# Dùng Gemini API (text-embedding-004, dim=768). Reuses LLM_API_KEY.
# Nếu đổi model, phải xóa collection Qdrant cũ (dim thay đổi).
EMBED_MODEL=text-embedding-004

# ── Redis ──────────────────────────────────────────────────────────────────────
# Dùng cho: CTR store (Phase 2 Feedback) và Job status (Phase 3 Retrain).
# Chạy local: docker run -p 6379:6379 redis:7-alpine
REDIS_URL=redis://localhost:6379
